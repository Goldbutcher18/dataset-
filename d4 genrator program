def validate_dataset(data):
    errors = []

    ids = [record["source_id"] for record in data]

    if len(ids) != len(set(ids)):
        errors.append("Duplicate source_id found")

    required_fields = [
        "source_id",
        "title",
        "department",
        "state",
        "source_url",
        "topic",
        "procedure_type",
        "content",
        "verified_status",
        "source_authority",
        "retrieved_at",
        "data_origin"
    ]

    for i, record in enumerate(data, start=1):
        for field in required_fields:
            if field not in record or not record[field]:
                errors.append(
                    f"Record {i}: Missing field '{field}'"
                )

    return errors


# Validate
